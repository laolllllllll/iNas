{
  "name": "inas",
  "version": "2.2026.1010",
  "description": "iNas - Application Platform v2",
  "main": "main.js",
  "author": "cor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir --win",
    "build:installer": "bash build/build-installer.sh"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "qrcode": "^1.5.3",
    "multer": "^1.4.5-lts.1",
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.cor.inas",
    "productName": "iNas",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "renderer/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!**/*.{md,markdown}"
    ],
    "asar": true
  }
}
